.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# ===========================================================================
# 本地测试与调试产物（不进入仓库）
# ===========================================================================
# 本地测试文档
test-docs/

# 本地 UI 预览（Edge profile / 预览目录）
.preview/
.preview-profile*/

