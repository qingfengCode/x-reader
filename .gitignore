.smoke-*.png
.check-*.png
.after-*.png
.edge-*
.repro.png

# 临时目录 / 脚本 / 截图（.tmp-*、.tmp-xxx.mjs 等）
.tmp*

# Python 脚本缓存
__pycache__/
*.py[cod]
.venv/
venv/
